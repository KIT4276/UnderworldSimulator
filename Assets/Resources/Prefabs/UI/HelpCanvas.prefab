  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u0430\u0436\u0434\u043E\u0435 \u043F\u043E\u0436\u0435\u043B\u0430\u043D\u0438\u0435
    \u0438\u043C\u0435\u0435\u0442 \u0441\u0432\u043E\u044E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u0432 \u0437\u0432\u0435\u0437\u0434\u0430\u0445. \u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441-\u0431\u0430\u0440
    \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u0442\u0435\u043F\u0435\u043D\u044C
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F. \u0415\u0441\u043B\u0438
    \u043F\u043E\u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u043E
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C\u0441\u044F, \u0437\u0432\u0435\u0437\u0434\u044B
    \u0432\u044B\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u0438\u0437 \u043E\u0431\u0449\u0435\u0433\u043E
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430."
