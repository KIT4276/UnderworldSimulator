  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
    \u043C\u0435\u0431\u0435\u043B\u0438 \u0435\u0441\u0442\u044C \u0442\u0440\u0438
    \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430: \u041A\u043E\u043C\u0444\u043E\u0440\u0442,
    \u042D\u0441\u0442\u0435\u0442\u0438\u043A\u0430 \u0438 \u0414\u043E\u0441\u0443\u0433.
    \u0422\u0430\u043A\u0438\u0435 \u0436\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B
    \u0435\u0441\u0442\u044C \u0443 \u043A\u043E\u043C\u043D\u0430\u0442. \u041E\u043D\u0438
    \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0438\u0437
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0445
    \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435."
  m_isRightToLeft: 0
