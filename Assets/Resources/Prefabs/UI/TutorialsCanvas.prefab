      m_Calls: []
  m_text: "\u0415\u0441\u043B\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432
    \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u043D\u0430\u0436\u043C\u0438 <color=#740004>\"\u0418\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\"</color>.
    \u041F\u0440\u0435\u0434\u043C\u0435\u0442 \u043F\u043E\u043F\u0430\u0434\u0435\u0442
    \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C."
  m_isRightToLeft: 0
